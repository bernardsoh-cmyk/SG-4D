<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- .Light matters: plain Theme.Material is the DARK Material theme, which
         is what this inherited from the app it was copied from. The window
         colours below were overridden to white, but every native surface the
         WebView does not cover - the consent dialog, the ad container, the
         WebView's own background before the page paints - kept rendering dark
         against a light app. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <!-- White status bar, so its icons have to be dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <!-- Same for the nav bar. Ignored below API 27, which is fine. -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
